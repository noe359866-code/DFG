# Copia este archivo a .dev.vars (se lee con `npm run dev` / wrangler dev).
# En producción usa `npx wrangler secret put <NOMBRE>`; nunca publiques .dev.vars.

# Supabase - Obtén estas claves en: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Preferir ANON con RLS SELECT de solo lectura en torrents y tv_channels.
# SERVICE_ROLE solo en servidor, si es necesario.
SUPABASE_ANON_KEY=tu_clave_anon
# SUPABASE_SERVICE_ROLE_KEY=tu_clave_privada

# Opcional: restringe las columnas seleccionadas de torrents (por defecto: *).
# Incluye al menos los campos utilizados por el addon.
# SUPABASE_TORRENT_COLUMNS=imdb_id,season,episode,info_hash,magnet_url,seeders,title

# Opcional: proyección de tv_channels; por defecto usa los 9 campos del esquema compartido.
# Si tu esquema usa otros nombres, indica aquí la lista exacta de columnas existentes.
# Añade description, language o sort_order si quieres mostrarlos.
# Usa * para solicitar todas las columnas (más respuesta/memoria; no recomendado como ajuste normal).
# SUPABASE_TV_CHANNEL_COLUMNS=id,name,slug,logo_url,stream_url,stream_type,category,country_code,is_active,description,language,sort_order
# SUPABASE_TV_CHANNEL_COLUMNS=*
