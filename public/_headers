# Cabeceras para los archivos servidos por Workers Static Assets (el Worker
# aplica las mismas cabeceras en local y en las rutas dinámicas).
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Headers: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# La portada revalida en cada visita (ETag incluido): así deja de anunciar la
# versión anterior en cuanto se publica un despliegue nuevo. Es el valor por
# defecto de Workers Static Assets, declarado aquí a propósito.
/
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Headers: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
