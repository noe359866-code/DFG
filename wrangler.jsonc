{
  // Cloudflare Workers - Nexo Play (API en worker.mjs + landing/assets en public/)
  // Despliegue: npm run deploy:cloudflare  (antes: npx wrangler login)
  // Secretos:   npx wrangler secret put SUPABASE_URL
  //             npx wrangler secret put SUPABASE_ANON_KEY
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexo-play",
  "main": "worker.mjs",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  }
}
