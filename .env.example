# Supabase - Copia este archivo a .env y completa tus credenciales
# Obtén estas claves en: https://supabase.com/dashboard/project/_/settings/api
# Este archivo se usa con `npm start` (servidor local en Node).
# Para `npm run dev` (wrangler dev) usa .dev.vars; en producción,
# `npx wrangler secret put SUPABASE_URL` y lo mismo con las claves.

SUPABASE_URL=https://xxxxxxxx.supabase.co
# Opcional: clave privilegiada, SOLO servidor. Preferir ANON con RLS de lectura.
# SUPABASE_SERVICE_ROLE_KEY=tu_clave_privada

# Alternativa si usas políticas RLS de solo lectura en torrents y tv_channels
# Si no tienes SERVICE_ROLE, el addon usará esta:
SUPABASE_ANON_KEY=tu_clave_anon

# Opcional: restringe las columnas seleccionadas de torrents (por defecto: *)
# Usa una lista separada por comas e incluye los campos requeridos por el addon.
# SUPABASE_TORRENT_COLUMNS=imdb_id,season,episode,info_hash,magnet_url,seeders,title

# Opcional - Puerto local para desarrollo
PORT=7000

# Opcional - Entorno
NODE_ENV=production
